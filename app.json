{
  "expo": {
    "name": "Reelix",
    "slug": "reelix",
    "scheme": "reelix",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true },
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.reelix.mobile" },
    "android": { "package": "app.reelix.mobile", "edgeToEdgeEnabled": true }
  }
}