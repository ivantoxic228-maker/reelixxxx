{
  "expo": {
    "name": "Reelix",
    "slug": "reelix",
    "scheme": "reelix",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Разреши Reelix использовать камеру для съёмки видео.",
          "microphonePermission": "Разреши Reelix использовать микрофон для записи звука."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.reelix.mobile"
    },
    "android": {
      "package": "app.reelix.mobile",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "451729a2-1c42-496e-a190-137e26d72300"
      }
    }
  }
}